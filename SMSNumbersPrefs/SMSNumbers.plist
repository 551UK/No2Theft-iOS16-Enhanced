<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict><key>items</key><array>
  <dict>
    <key>cell</key><string>PSGroupCell</string>
    <key>label</key><string>SMS Recipients</string>
    <key>footerText</key><string>Edits only existing No2Theft SMS recipient numbers. No2Theft's original settings and alert code stay unchanged. Respring after editing.</string>
  </dict>
  <dict>
    <key>cell</key><string>PSEditTextCell</string>
    <key>label</key><string>Recipient 1</string>
    <key>key</key><string>firstNumber</string>
    <key>placeholder</key><string>e.g. +447123456789</string>
    <key>defaults</key><string>com.elias.no2theft3</string>
  </dict>
  <dict>
    <key>cell</key><string>PSEditTextCell</string>
    <key>label</key><string>Recipient 2</string>
    <key>key</key><string>secondNumber</string>
    <key>placeholder</key><string>Optional second number</string>
    <key>defaults</key><string>com.elias.no2theft3</string>
  </dict>
</array></dict>
</plist>
